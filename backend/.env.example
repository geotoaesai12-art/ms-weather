# Server
PORT=5000
# Use "production" when the site is live (turns on proxy support and removes local-only CORS origins)
NODE_ENV=development

# OpenWeather API key (get your own at https://openweathermap.org/api). Never share it or commit it.
OPENWEATHER_API_KEY=

# Comma-separated list of websites allowed to call this API (no trailing slash).
# Local:      http://localhost:5173
# Live site:  https://your-site.vercel.app   (add your own domain too if you have one)
ALLOWED_ORIGINS=http://localhost:5173

# Contact form (messages arrive in your Gmail). Get the key from https://resend.com > API Keys.
RESEND_API_KEY=
# The inbox that receives messages. On Resend's free plan this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional: sender name/address. Leave empty until you verify your own domain in Resend.
CONTACT_FROM=
