# Public values only. Everything starting with VITE_ is visible to every visitor. NEVER put API keys here.

# Leave EMPTY. Locally Vite forwards /api to the backend, and on Vercel the API is on the same address as the website.
# Only fill this if you host the API on a different address.
VITE_API_BASE_URL=

# Public contact email shown on the Contact page, e.g. you@example.com
VITE_CONTACT_EMAIL=
