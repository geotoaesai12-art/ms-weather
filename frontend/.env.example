# Public values only. Everything starting with VITE_ is visible to every visitor. NEVER put API keys here.

# Local development: leave EMPTY (Vite proxies /api to http://localhost:5000).
# Production (Vercel): set this to your live backend URL, e.g. https://ms-weather-api.onrender.com (no trailing slash).
VITE_API_BASE_URL=

# Public contact email shown on the Contact page, e.g. you@example.com
VITE_CONTACT_EMAIL=
